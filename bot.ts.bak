bot.hears('👤 Профиль', (ctx) => {
  const user = db.users[ctx.from.id];
  ctx.reply(`👤 <b>Твой Профиль</b>\n\nID: <code>${user.id}</code>\nИмя: <b>${user.first_name}</b>\nБаланс: <b>${user.balance}</b> 💎`, { parse_mode: 'HTML' });
}, { parse_mode: 'HTML' });

bot.hears('🎁 Ежедневный бонус', (ctx) => {
  const user = db.users[ctx.from.id];
  const now = Date.now();
  const DAY = 24 * 60 * 60 * 1000;
  
  if (now - user.lastBonus >= DAY) {
    user.balance += db.settings.dailyBonus;
    user.lastBonus = now;
    saveDB();
    ctx.reply(`🎁 Вы получили ежедневный бонус: <b>${db.settings.dailyBonus}</b> 💎!\nВаш баланс: ${user.balance} 💎`, { parse_mode: 'HTML' });
  } else {
    const left = DAY - (now - user.lastBonus);
    const hours = Math.floor(left / (1000 * 60 * 60));
    const minutes = Math.floor((left % (1000 * 60 * 60)) / (1000 * 60));
    ctx.reply(`⏳ Следующий бонус будет доступен через ${hours}ч ${minutes}м.`);
  }
});

bot.hears('🎟️ Промокод', (ctx) => {
  if (ctx.session) ctx.session.state = 'wait_promo_code';
  ctx.reply('Введите промокод:', Markup.inlineKeyboard([[Markup.button.callback('Отмена', 'cancel_state')]]));
});



// Fast Game Shortcut: "токен 1000"
bot.hears(/^(?:токен|token|ставка|bet)\s+(\d+)$/i, async (ctx) => {
    if (ctx.chat.type === 'private') {
        return ctx.reply('❌ Играть можно только в групповых чатах! Добавьте бота в свою группу.');
    }

    const bet = parseInt(ctx.match[1]);
    const userId = ctx.from.id;
    const user = db.users[userId];

    if (db.activeGames[userId]?.status === 'active') {
        return ctx.reply('У вас уже есть активная игра! Завершите её.', { reply_parameters: { message_id: ctx.message.message_id } });
    }
    if (bet < 100) return ctx.reply('❌ Минимум 100 токенов.', { reply_parameters: { message_id: ctx.message.message_id } });
    if (!user || user.balance < bet) return ctx.reply('❌ Недостаточно токенов на балансе.', { reply_parameters: { message_id: ctx.message.message_id } });

    user.balance -= bet;
    const field = generateMinesField(20, db.settings.minesCount);
    db.activeGames[userId] = { userId, bet, field, opened: [], status: 'active' };
    saveDB();
    
    await ctx.reply(`🎮 <b>Mines 5x4</b>\nСтавка: <b>${bet}</b> 💎\nМин: <b>${db.settings.minesCount}</b> 💣`, { parse_mode: 'HTML',
        reply_parameters: { message_id: ctx.message.message_id },
        ...renderMinesKeyboard(db.activeGames[userId])
    });
});

