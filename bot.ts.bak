bot.on('text', async (ctx, next) => {
  const state = ctx.session?.state;
  const text = ctx.message.text;
  const userId = ctx.from.id;
  const user = db.users[userId];

  if (!state) return next();

  if (state === 'wait_promo_code') {
    const promo = db.promos[text.trim()];
    if (!promo || !promo.isActive || (promo.expiry && Date.now() > promo.expiry) || (promo.uses >= promo.maxUses && promo.maxUses !== 0) || promo.usedBy.includes(userId)) {
      ctx.reply('❌ Промокод недействителен или уже использован.');
    } else {
      user.balance += promo.tokens;
      promo.uses += 1;
      promo.usedBy.push(userId);
      saveDB();
      ctx.reply(`✅ Вы активировали промокод и получили <b>${promo.tokens}</b> 💎!`, { parse_mode: 'HTML' });
    }
    ctx.session = {}; return;
  }

  if (state === 'wait_bet') {
    const bet = parseInt(text);
    if (isNaN(bet) || bet < 100) return ctx.reply('❌ Минимум 100 токенов.');
    if (user.balance < bet) return ctx.reply('❌ Недостаточно токенов.');

    user.balance -= bet;
    const field = generateMinesField(20, db.settings.minesCount); // 5x4 = 20
    db.activeGames[userId] = { userId, bet, field, opened: [], status: 'active' };
    saveDB();
    ctx.session = {};
    
    const msg = await ctx.reply(`🎮 <b>Mines 5x4</b>\nСтавка: ${bet} 💎\nМин: ${db.settings.minesCount} 💣`, {
        parse_mode: 'HTML',
        ...renderMinesKeyboard(db.activeGames[userId])
    });
    db.activeGames[userId].messageId = msg.message_id;
    saveDB();
    return;
  }

  // Admin States
  if (!db.settings.adminIds.includes(userId)) return next();

  if (state === 'admin_add_id') {
      const id = parseInt(text);
      if (!isNaN(id) && !db.settings.adminIds.includes(id)) {
          db.settings.adminIds.push(id);
          saveDB();
      }
      ctx.reply(`✅ ID ${id} назначен администратором.`);
      ctx.session = {}; return;
  }

  if (state === 'admin_remove_id') {
      const id = parseInt(text);
      db.settings.adminIds = db.settings.adminIds.filter(x => x !== id);
      saveDB();
      ctx.reply(`✅ ID ${id} удален из администраторов.`);
      ctx.session = {}; return;
  }

  if (state === 'admin_give_id' || state === 'admin_take_id' || state === 'admin_user_info_id') {
      const targetId = parseInt(text);
      if (isNaN(targetId) || !db.users[targetId]) return ctx.reply('Пользователь не найден.');
      if (state === 'admin_user_info_id') {
          const target = db.users[targetId];
          ctx.reply(`👤 <b>Пользователь</b>\nID: ${target.id}\nИмя: ${target.first_name}\nБаланс: ${target.balance}\nБан: ${target.isBlocked ? 'Да' : 'Нет'}`, {
              parse_mode: 'HTML',
              ...Markup.inlineKeyboard([[Markup.button.callback(target.isBlocked ? '🔓 Разблокировать' : '🚫 Заблокировать', `toggle_block_${target.id}`)]])
          });
          ctx.session = {};
      } else {
          ctx.session.tempData = { targetId };
          ctx.session.state = state === 'admin_give_id' ? 'admin_give_amount' : 'admin_take_amount';
          ctx.reply('Введите сумму:');
      }
      return;
  }

  if (state === 'admin_give_amount' || state === 'admin_take_amount') {
      const amount = parseInt(text);
      const target = db.users[ctx.session?.tempData?.targetId];
      if (state === 'admin_give_amount') {
          target.balance += amount;
          ctx.reply(`✅ Выдано ${amount} 💎.`);
      } else {
          target.balance = Math.max(0, target.balance - amount);
          ctx.reply(`✅ Списано ${amount} 💎.`);
      }
      saveDB();
      ctx.session = {}; return;
  }
  
  if (state === 'admin_broadcast') {
      let count = 0;
      for (const id in db.users) {
          try {
              await bot.telegram.sendMessage(id, `📢 <b>Рассылка</b>\n\n${text}`, { parse_mode: 'HTML' });
              count++;
          } catch(e) {}
      }
      ctx.reply(`✅ Рассылка доставлена: ${count} пользователям.`);
      ctx.session = {}; return;
  }

  // Quick promo setup for brevity...
  if (state === 'admin_promo_name') {
      const parts = text.trim().split(' ');
      const codeName = parts[0];
      const tokensAmount = parts[1] ? parseInt(parts[1]) : 1000;
      
      db.promos[codeName] = { code: codeName, tokens: isNaN(tokensAmount) ? 1000 : tokensAmount, maxUses: 0, uses: 0, expiry: null, isActive: true, usedBy: [] };
      saveDB();
      ctx.reply(`✅ Промокод ${codeName} на ${isNaN(tokensAmount) ? 1000 : tokensAmount} 💎 создан!`);
      ctx.session = {}; return;
  }

  next();
});

