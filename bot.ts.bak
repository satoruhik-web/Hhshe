import { Telegraf, Markup, session, Context } from 'telegraf';
import fs from 'fs';
import path from 'path';

// Types
interface User {
  id: number;
  username?: string;
  first_name?: string;
  balance: number;
  lastBonus: number;
  isBlocked: boolean;
}

interface Promo {
  code: string;
  tokens: number;
  maxUses: number;
  uses: number;
  expiry: number | null;
  isActive: boolean;
  usedBy: number[];
}

interface Settings {
  dailyBonus: number;
  adminIds: number[];
  minesCount: number;
  multipliers: Record<number, number>;
}

interface Game {
  userId: number;
  bet: number;
  field: boolean[]; 
  opened: number[];
  status: 'active' | 'won' | 'lost';
  messageId?: number;
}

interface BotDB {
  users: Record<number, User>;
  promos: Record<string, Promo>;
  settings: Settings;
  activeGames: Record<number, Game>;
  history: any[];
}

interface SessionData {
  state?: string;
  tempData?: any;
}

interface MyContext extends Context {
  session?: SessionData;
}

// Multipliers for 5x4 (20 cells)
const defaultMultipliers: Record<number, number> = {
  1: 1.15, 2: 1.35, 3: 1.60, 4: 1.90, 5: 2.30,
  6: 2.80, 7: 3.50, 8: 4.40, 9: 5.60, 10: 7.20,
  11: 9.50, 12: 13.00, 13: 18.00, 14: 26.00, 15: 40.00,
  16: 65.00, 17: 110.00, 18: 200.00, 19: 400.00
};

// Premium Photos
// DB Setup
const DB_PATH = path.join(process.cwd(), 'bot_db.json');
export let db: BotDB = {
  users: {},
  promos: {},
  settings: {
    dailyBonus: 1500,
    adminIds: [],
    minesCount: 8,
    multipliers: defaultMultipliers
  },
  activeGames: {},
  history: []
};

function loadDB() {
  if (fs.existsSync(DB_PATH)) {
    try {
      const data = JSON.parse(fs.readFileSync(DB_PATH, 'utf-8'));
      db = { ...db, ...data };
      if (!db.settings.multipliers) db.settings.multipliers = defaultMultipliers;
    } catch (e) {
      console.error('Error loading bot_db.json', e);
    }
  } else {
    saveDB();
  }
}

export function saveDB() {
  fs.writeFileSync(DB_PATH, JSON.stringify(db, null, 2));
}

loadDB();

