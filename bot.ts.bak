        saveDB();
        ctx.answerCbQuery(db.users[targetId].isBlocked ? 'Заблокирован' : 'Разблокирован');
    }
});


// 5x4 Mines Logic (20 total)
function generateMinesField(total: number, mines: number): boolean[] {
    const field = Array(total).fill(false);
    let placed = 0;
    while (placed < mines) {
        const idx = Math.floor(Math.random() * total);
        if (!field[idx]) { field[idx] = true; placed++; }
    }
    return field;
}

function renderMinesKeyboard(game: Game) {
    const keyboard = [];
    let row = [];
    for (let i = 0; i < 20; i++) { // 20 cells
        if (game.status === 'active') {
            if (game.opened.includes(i)) row.push(Markup.button.callback('💎', `ignore`));
            else row.push(Markup.button.callback('🟩', `mine_${i}`));
        } else {
            if (game.field[i]) row.push(Markup.button.callback(game.opened.includes(i) ? '💥' : '💣', 'ignore'));
            else row.push(Markup.button.callback(game.opened.includes(i) ? '💎' : '🟩', 'ignore'));
        }
        if (row.length === 5) { keyboard.push(row); row = []; }
    }
    
    if (game.status === 'active' && game.opened.length > 0) {
        const nextMult = db.settings.multipliers[game.opened.length] || 1;
        const currentWin = Math.floor(game.bet * nextMult);
        keyboard.push([Markup.button.callback(`💰 Забрать ${currentWin} 💎 💰`, 'cashout')]);
    } else if (game.status !== 'active') {
        keyboard.push([Markup.button.callback(`🔄 Сыграть еще раз`, 'play_again')]);
    }
    
    return Markup.inlineKeyboard(keyboard);
}

bot.action('ignore', (ctx) => ctx.answerCbQuery());

bot.action(/^mine_(\d+)$/, async (ctx) => { ctx.answerCbQuery().catch(()=>{});
    const userId = ctx.from.id;
    const game = db.activeGames[userId];
    if (!game || game.status !== 'active') return ctx.answerCbQuery('Игра окончена', { show_alert: true });
    
    const idx = parseInt(ctx.match[1]);
    if (game.opened.includes(idx)) return ctx.answerCbQuery();
    game.opened.push(idx);
    
    if (game.field[idx]) {
        game.status = 'lost';
        db.history.push({ userId, bet: game.bet, win: 0, date: Date.now() });
        saveDB();
        await ctx.editMessageText(`💥 <b>БУМ!</b> Вы попали на мину!\nСтавка ${game.bet} 💎 проиграна.`, {
            parse_mode: 'HTML', ...renderMinesKeyboard(game)
        });
    } else {
        const openedCount = game.opened.length;
        const totalSafe = 20 - db.settings.minesCount;
        
        if (openedCount === totalSafe) {
            game.status = 'won';
            const mult = db.settings.multipliers[openedCount] || 1;
            const win = Math.floor(game.bet * mult);
            db.users[userId].balance += win;
            db.history.push({ userId, bet: game.bet, win, date: Date.now() });
            saveDB();
            await ctx.editMessageText(`🎉 <b>ИДЕАЛЬНАЯ ПОБЕДА!</b>\nВыигрыш: ${win} 💎!`, {
                parse_mode: 'HTML', ...renderMinesKeyboard(game)
            });
        } else {
            const currentMult = db.settings.multipliers[openedCount] || 1;
            const currentWin = Math.floor(game.bet * currentMult);
            saveDB();
            try {
                await ctx.editMessageText(`🎮 <b>Mines 5x4</b>\nСтавка: ${game.bet} 💎\nОткрыто: ${openedCount}\nТекущий выигрыш: <b>${currentWin} 💎</b>`, {
                    parse_mode: 'HTML', ...renderMinesKeyboard(game)
                });
            } catch(e) {}
        }
    }
});

bot.action('cashout', async (ctx) => { ctx.answerCbQuery().catch(()=>{});
    const userId = ctx.from.id;
    const game = db.activeGames[userId];
    if (!game || game.status !== 'active') return ctx.answerCbQuery();
    
    const openedCount = game.opened.length;
    if (openedCount === 0) return ctx.answerCbQuery();
    
    const currentMult = db.settings.multipliers[openedCount] || 1;
    const win = Math.floor(game.bet * currentMult);
    game.status = 'won';
    db.users[userId].balance += win;
    db.history.push({ userId, bet: game.bet, win, date: Date.now() });
    saveDB();
    
    await ctx.editMessageText(`💰 <b>Вы успешно забрали выигрыш!</b>\nСумма: +${win} 💎.`, {
        parse_mode: 'HTML', ...renderMinesKeyboard(game)
    });
});

bot.action('play_again', (ctx) => { ctx.answerCbQuery().catch(()=>{});
    if (ctx.session) ctx.session.state = 'wait_bet';
    ctx.editMessageText(`🎮 <b>Mines 5x4</b>\n\nВведите сумму ставки (мин. 100 💎):`, Markup.inlineKeyboard([[Markup.button.callback('Отмена', 'cancel_state')]]));
});

export function startTelegramBot() {
    bot.launch({ dropPendingUpdates: true }).catch(err => console.error('Telegram bot launch error:', err));
    console.log('Telegram bot is starting...');
    process.once('SIGINT', () => bot.stop('SIGINT'));
    process.once('SIGTERM', () => bot.stop('SIGTERM'));
}
